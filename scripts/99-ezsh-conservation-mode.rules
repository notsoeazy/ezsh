# Lets members of the "wheel" group switch battery conservation mode on Lenovo IdeaPad / LOQ laptops
# (ideapad_acpi) without root, for ezsh's Battery page. The file is root-only otherwise.
#
# Install, then reboot (or apply once now with the two commands after it):
#   sudo install -m 644 scripts/99-ezsh-conservation-mode.rules /etc/udev/rules.d/
#   sudo chgrp wheel /sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/conservation_mode
#   sudo chmod g+w /sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/conservation_mode
ACTION=="add|bind", SUBSYSTEM=="platform", DRIVER=="ideapad_acpi", RUN+="/usr/bin/chgrp wheel /sys%p/conservation_mode", RUN+="/usr/bin/chmod g+w /sys%p/conservation_mode"
